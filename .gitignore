# Only the rices, the switcher script and the top-level README are tracked.
# Each rice's cosmic/ folder holds a subset of ~/.config/cosmic.

# Ignore everything by default
*

# ...except these
!/.gitignore
!/README.md
!/switch-rice.sh
!/rices/
!/rices/**

# Personal settings that are not part of a rice's look: Files sidebar
# bookmarks, wallpaper history, weather location, clock format, keyboard
# layout and screenshot preferences
**/cosmic/com.system76.CosmicFiles/v1/favorites
**/cosmic/com.system76.CosmicSettings.Wallpaper/v1/custom-images
**/cosmic/com.vintagetechie.CosmicExtAppletTempest/
**/cosmic/com.system76.CosmicAppletTime/
**/cosmic/com.system76.CosmicPortal/
**/cosmic/com.system76.CosmicComp/v1/xkb_config
